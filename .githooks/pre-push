#!/bin/sh
# push される範囲の全コミットを、push の瞬間の語彙で検査する。
#
# なぜ CI では足りないか: GitHub Actions は push / PR の**後**に走る。
# このリポジトリは PUBLIC なので、CI が検出した時点で内容はもう公開されている。
#
# なぜ作業ツリーではなくコミットを見るか: 以前のこのフックは作業ツリーを
# 検査していた。push されるのはコミットなので、作業ツリーが clean な状態で
# 漏洩入りのブランチを push すると素通りした（実際、作業ツリーを丸ごと保存した
# ブランチ5本が、番組設定の写し・全キャストの名簿・開発機のパスを抱えていた）。
#
# なぜ push の瞬間か: pack の語彙は後から増える。コミット時点で clean でも、
# 後から登録された地名や人名で漏洩に変わる（実際に起きた）。
#
# 入れ方: npm run hooks:install
# このフックを迂回する手段は書かない。git 自体は --no-verify を持つが、それは
# 「検査を通していない push」であって、PUBLIC リポジトリでは取り消せない。
# 検査が誤検出だと思うなら、config/public-surface-allowlist.json に理由と件数を書いて通す。
if ! node scripts/audit-public-surface.mjs --push-stdin --require-signals; then
  echo ""
  echo "公開面の検査が通らないので push を止めました。"
  echo "PUBLIC なリポジトリなので、push した後に消しても履歴には残ります。"
  exit 1
fi
