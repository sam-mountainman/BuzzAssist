            "cutId": "cut-02",
            "order": 1,
            "speakerName": "ナレーション",
            "speakerId": "narration",
            "text": "商店街の古い写真店で、蓮は色あせた家族写真を一枚ずつ補修していた。",
            "bubbleId": "bubble-cut-02-u01",
            "preset": "narration"
          },
