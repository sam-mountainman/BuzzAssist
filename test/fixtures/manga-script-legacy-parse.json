            "id": "cut-03-u03",
            "cutId": "cut-03",
            "order": 3,
            "speakerName": "水野 澪",
            "speakerId": "speaker-9cdd4901f7",
            "text": "帰ってきたの。行く場所はあるのに、帰りたい場所が分からなくなって",
