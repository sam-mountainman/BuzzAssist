      "expected": {
        "title": "消えかけた写真に、帰る場所が写っていた",
        "cuts": [
          {
            "id": "cut-01",
            "number": 1,
            "purpose": "雨の写真店",
            "utterances": [
              {
                "id": "cut-01-u01",
                "cutId": "cut-01",
                "order": 1,
                "speakerName": "ナレーション",
                "speakerId": "narration",
                "text": "写真は、光がそこにあったことを証明する。",
                "bubbleId": "bubble-cut-01-u01",
                "preset": "narration"
              },
              {
                "id": "cut-01-u02",
                "cutId": "cut-01",
                "order": 2,
                "speakerName": "ナレーション",
                "speakerId": "narration",
                "text": "けれど、写した人の名前まで守ってくれるわけではない。",
                "bubbleId": "bubble-cut-01-u02",
                "preset": "narration"
              },
              {
                "id": "cut-01-u03",
                "cutId": "cut-01",
                "order": 3,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "雨、強くなったな。閉店前に、この現像だけ終わらせよう",
                "bubbleId": "bubble-cut-01-u03",
                "preset": "dialogue"
              }
            ]
          },
          {
            "id": "cut-02",
            "number": 2,
            "purpose": "思い出を直す仕事",
            "utterances": [
              {
                "id": "cut-02-u01",
                "cutId": "cut-02",
                "order": 1,
                "speakerName": "ナレーション",
                "speakerId": "narration",
                "text": "商店街の古い写真店で、蓮は色あせた家族写真を一枚ずつ補修していた。",
                "bubbleId": "bubble-cut-02-u01",
                "preset": "narration"
              },
              {
                "id": "cut-02-u02",
                "cutId": "cut-02",
                "order": 2,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "思い出は新品にできません。でも、もう一度見える形には戻せます",
                "bubbleId": "bubble-cut-02-u02",
                "preset": "dialogue"
              }
            ]
          },
          {
            "id": "cut-03",
            "number": 3,
            "purpose": "十年ぶりの再会",
            "utterances": [
              {
                "id": "cut-03-u01",
                "cutId": "cut-03",
                "order": 1,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "その言い方、昔と変わらないね。蓮",
                "bubbleId": "bubble-cut-03-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-03-u02",
                "cutId": "cut-03",
                "order": 2,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "澪なのか？　東京にいるはずじゃ……",
                "bubbleId": "bubble-cut-03-u02",
                "preset": "thought"
              },
              {
                "id": "cut-03-u03",
                "cutId": "cut-03",
                "order": 3,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "帰ってきたの。行く場所はあるのに、帰りたい場所が分からなくなって",
                "bubbleId": "bubble-cut-03-u03",
                "preset": "dialogue"
              }
            ]
          },
          {
            "id": "cut-04",
            "number": 4,
            "purpose": "奪われた写真",
            "utterances": [
              {
                "id": "cut-04-u01",
                "cutId": "cut-04",
                "order": 1,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "私が撮った写真を、恋人だった神谷さんが自分の作品として発表したの",
                "bubbleId": "bubble-cut-04-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-04-u02",
                "cutId": "cut-04",
                "order": 2,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "元データか、撮影した日を証明できるものは？",
                "bubbleId": "bubble-cut-04-u02",
                "preset": "dialogue"
              },
              {
                "id": "cut-04-u03",
                "cutId": "cut-04",
                "order": 3,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "全部向こうに預けたまま。信じていたから",
                "bubbleId": "bubble-cut-04-u03",
                "preset": "dialogue"
              }
            ]
          },
          {
            "id": "cut-05",
            "number": 5,
            "purpose": "追ってきた男",
            "utterances": [
              {
                "id": "cut-05-u01",
                "cutId": "cut-05",
                "order": 1,
                "speakerName": "神谷 玲司",
                "speakerId": "speaker-6514294bb2",
                "text": "連絡を無視するから迎えに来た。君は僕の助手だ。勝手に帰られると困る",
                "bubbleId": "bubble-cut-05-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-05-u02",
                "cutId": "cut-05",
                "order": 2,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "彼女の作品を、あなたの名前で出したんですか",
                "bubbleId": "bubble-cut-05-u02",
                "preset": "dialogue"
              },
              {
                "id": "cut-05-u03",
                "cutId": "cut-05",
                "order": 3,
                "speakerName": "神谷 玲司",
                "speakerId": "speaker-6514294bb2",
                "text": "世に出したのは僕だ。名前なんて、売れる側のものだろう",
                "bubbleId": "bubble-cut-05-u03",
                "preset": "dialogue"
              }
            ]
          },
          {
            "id": "cut-06",
            "number": 6,
            "purpose": "居場所を否定する言葉",
            "utterances": [
              {
                "id": "cut-06-u01",
                "cutId": "cut-06",
                "order": 1,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "私は戻らない。あの写真は、祖母の最後の夏を撮った大切な記録なの",
                "bubbleId": "bubble-cut-06-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-06-u02",
                "cutId": "cut-06",
                "order": 2,
                "speakerName": "神谷 玲司",
                "speakerId": "speaker-6514294bb2",
                "text": "感情で仕事を失うつもりか？　この町に君の居場所なんてない",
                "bubbleId": "bubble-cut-06-u02",
                "preset": "dialogue"
              }
            ]
          },
          {
            "id": "cut-07",
            "number": 7,
            "purpose": "残されていた証拠",
            "utterances": [
              {
                "id": "cut-07-u01",
                "cutId": "cut-07",
                "order": 1,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "ある。澪が十年前に預けたネガです",
                "bubbleId": "bubble-cut-07-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-07-u02",
                "cutId": "cut-07",
                "order": 2,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "去年複製したデータも、作成日時も、依頼票も残っています",
                "bubbleId": "bubble-cut-07-u02",
                "preset": "dialogue"
              },
              {
                "id": "cut-07-u03",
                "cutId": "cut-07",
                "order": 3,
                "speakerName": "神谷 玲司",
                "speakerId": "speaker-6514294bb2",
                "text": "そんな古い記録が、何になる",
                "bubbleId": "bubble-cut-07-u03",
                "preset": "dialogue"
              }
            ]
          },
          {
            "id": "cut-08",
            "number": 8,
            "purpose": "名前を取り戻す",
            "utterances": [
              {
                "id": "cut-08-u01",
                "cutId": "cut-08",
                "order": 1,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "展示の主催者へ送る。撮影者が誰か、私の名前で確かめてもらう",
                "bubbleId": "bubble-cut-08-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-08-u02",
                "cutId": "cut-08",
                "order": 2,
                "speakerName": "ナレーション",
                "speakerId": "narration",
                "text": "翌週、展示は中止され、神谷との契約も解除された。",
                "bubbleId": "bubble-cut-08-u02",
                "preset": "narration"
              },
              {
                "id": "cut-08-u03",
                "cutId": "cut-08",
                "order": 3,
                "speakerName": "ナレーション",
                "speakerId": "narration",
                "text": "彼が借りた光は、彼自身を照らし返した。",
                "bubbleId": "bubble-cut-08-u03",
                "preset": "narration"
              }
            ]
          },
          {
            "id": "cut-09",
            "number": 9,
            "purpose": "子供の頃の約束",
            "utterances": [
              {
                "id": "cut-09-u01",
                "cutId": "cut-09",
                "order": 1,
                "speakerName": "少女の澪",
                "speakerId": "speaker-e21966d676",
                "text": "私が遠くに行っても、写真を捨てないでね",
                "bubbleId": "bubble-cut-09-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-09-u02",
                "cutId": "cut-09",
                "order": 2,
                "speakerName": "少年の蓮",
                "speakerId": "speaker-b6f0011ba7",
                "text": "捨てない。いつか帰ってきたら、ちゃんと返す",
                "bubbleId": "bubble-cut-09-u02",
                "preset": "dialogue"
              },
              {
                "id": "cut-09-u03",
                "cutId": "cut-09",
                "order": 3,
                "speakerName": "ナレーション",
                "speakerId": "narration",
                "text": "子供の約束は未来を縛らず、帰る道に小さな灯りを残すことがある。",
                "bubbleId": "bubble-cut-09-u03",
                "preset": "narration"
              }
            ]
          },
          {
            "id": "cut-10",
            "number": 10,
            "purpose": "新しい一枚目",
            "utterances": [
              {
                "id": "cut-10-u01",
                "cutId": "cut-10",
                "order": 1,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "店の二階、空いてるよね。ここで写真スタジオを始めたい",
                "bubbleId": "bubble-cut-10-u01",
                "preset": "dialogue"
              },
              {
                "id": "cut-10-u02",
                "cutId": "cut-10",
                "order": 2,
                "speakerName": "水野 澪",
                "speakerId": "speaker-9cdd4901f7",
                "text": "それから……今度は、蓮の隣にいたい",
                "bubbleId": "bubble-cut-10-u02",
                "preset": "dialogue"
              },
              {
                "id": "cut-10-u03",
                "cutId": "cut-10",
                "order": 3,
                "speakerName": "高瀬 蓮",
                "speakerId": "speaker-f97fa33a62",
                "text": "おかえり。仕事も、その先も、ゆっくり一緒に決めよう",
                "bubbleId": "bubble-cut-10-u03",
                "preset": "dialogue"
              },
              {
                "id": "cut-10-u04",
                "cutId": "cut-10",
                "order": 4,
                "speakerName": "ナレーション",
                "speakerId": "narration",
                "text": "雨上がりの商店街で、二人の新しい一枚目が静かに現像されていった。",
                "bubbleId": "bubble-cut-10-u04",
                "preset": "narration"
              }
            ]
          }
        ],
