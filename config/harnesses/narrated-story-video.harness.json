{
  "id": "narrated-story-video",
  "version": "1.4.0",
  "displayName": "ナレーション物語動画（実写素材＋カメラワーク）",
  "note": "クライアント名・チャンネル名はここに書かない。ここは『何が作れるか』の宣言であって、誰のためのものかの記録ではない。",
  "produces": {
    "kind": "narrated-story-video",
    "description": "台本から、シーン画像にカメラワークを当て、ナレーションと字幕とBGMを載せた動画にする",
    "aspectRatios": [
      "16:9"
    ],
    "typicalLengthSeconds": [
      120,
      300
    ]
  },
  "requiresFromOperator": [
    {
      "id": "script",
      "what": "日本語の生台本。セグメント分割はハーネスが行う",
      "blocking": true
    },
    {
      "id": "signed-channel-pack",
      "what": "画風、Voice、BGM方針、禁止事項、承認SHAを含む署名済みChannel Pack。provider secretは含めない",
      "blocking": true
    },
    {
      "id": "presenter-video",
      "what": "本人の撮影素材（レビュー章を付ける場合のみ）",
      "blocking": false
    }
  ],
  "guarantees": [
    {
      "id": "audio-loudness",
      "what": "統合-14 LUFS ±0.5、トゥルーピーク ≤ -1.5 dBFS",
      "evidenceAuditIds": [
        "audioIntegratedLoudness"
      ]
    },
    {
      "id": "narration-intelligibility",
      "what": "各発話区間で voice RMS − bed RMS ≥ 6dB。全体が合格でもナレーションが埋もれていれば落とす",
      "evidenceAuditIds": [
        "narrationBedSeparation",
        "perceptualReviewChecks"
      ]
    },
    {
      "id": "duration-conformance",
      "what": "ナレーション実尺が計画比±3%。超えたら画の尺を再計画する",
      "evidenceAuditIds": [
        "duration"
      ]
    },
    {
      "id": "content-addressing",
      "what": "text/voice/model/endpoint/params の指紋でキャッシュを識別。台本を直せば必ず作り直す",
      "evidenceAuditIds": [
        "frozenV1AndParentHashes",
        "parentAudioPcmPreserved"
      ]
    },
    {
      "id": "external-visual-signoff",
      "what": "目視サインオフは外部が書いたものだけを受け取る。finalizerは転記のみ",
      "evidenceAuditIds": [
        "perceptualReviewBoundToOutput",
        "perceptualEvidenceHashes",
        "contactSheetOriginalDetailReviewed"
      ]
    },
    {
      "id": "camera-continuity",
      "what": "全カットの開始/終了フレームを実測し、停止・逆走・座標飛びを落とす",
      "evidenceAuditIds": [
        "pixelAudit",
        "sceneTransitionOwnedByParent"
      ]
    },
    {
      "id": "bookend-audio-breath",
      "what": "OP→本編／本編→感想では映像トランジション中に次の声を重ねず、字幕なしlead-in後に字幕と次ナレーションを同時開始する。完成MP4で無音秒数・最大レベル・発話重複ゼロ・AV終端同期を測る",
      "evidenceAuditIds": [
        "audioBoundaryBreathV16",
        "noWholeProgramAcrossfade",
        "avEndSync"
      ]
    }
  ],
  "entrypoint": "node scripts/run-video-harness.mjs",
  "deploymentEntrypoint": "scripts/narrated-story-video.mjs",
  "runtimeMetadata": {
    "classification": "non-secret",
    "source": "signed-channel-pack:narrated-story.json",
    "imageModel": {
      "required": true,
      "sourceField": "runtime.imageModel",
      "mustEqual": "image.model"
    },
    "ttsProvider": {
      "required": true,
      "sourceField": "runtime.ttsProvider",
      "mustEqual": "voice.provider"
    },
    "adapterIdentity": {
      "image": [
        "image.provider",
        "image.model",
        "image.adapterVersion"
      ],
      "tts": [
        "voice.provider",
        "voice.model",
        "voice.adapterVersion"
      ],
      "music": [
        "music.provider",
        "music.model",
        "music.adapterVersion"
      ]
    },
    "providerSecretsAllowed": false
  },
  "canonicalSkills": [
    ".agents/skills/harness-parallel-execution/SKILL.md",
    ".agents/skills/narrated-story-video/SKILL.md"
  ],
  "learningTargets": [
    "genre:narrated-story-video"
  ],
  "status": "implementation-in-progress",
  "statusNote": "公開CoreのDAGはtest/narratedStoryVideoE2E.test.mjsでfixture adapterによるraw script→監査済み実MP4を検証し、署名Channel Packのimage/voice/music全adapter identityを外側doctorでも課金前probeする。server adapterのlocal contract回帰はあるが、実provider・配備済みbackend・外部目視signoffの運用検証が完了するまで本番provider運用可能とはしない",
  "entrypointNote": "上位入口はClaude/Codex共通。実際の配備rootだけをconfig/harness-deployments.jsonに持ち、配備内ではdeploymentEntrypointを使う。",
  "keywords": [
    "ナレーション",
    "朗読",
    "物語",
    "ストーリー",
    "実話",
    "bgm",
    "字幕",
    "テロップ",
    "感動"
  ],
  "keywordsNote": "依頼文からこのハーネスを言い当てるための短い手掛かり。日本語は空白で区切れないので、依頼文を刻むのではなくこちらの語が現れるかで見る。",
  "receiptAdapter": {
    "status": "ready",
    "implementation": "lib/harnessRunReceipt.mjs#recordGatesFromAuditChecks",
    "input": "checks object",
    "failClosed": true
  },
  "gateEvidenceNote": "各保証は evidenceAuditIds が全て pass のときだけ pass にできる。対応を書かずに保証だけ並べると、1つも走っていない状態でも「全部通った」と書けてしまう。",
  "reviewAttestation": {
    "subject": "narrated-story-video"
  }
}
