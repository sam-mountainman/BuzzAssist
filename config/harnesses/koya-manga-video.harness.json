  "requiresFromOperator": [
    {
      "id": "script",
      "what": "日本語の台本",
      "blocking": true
    },
    {
      "id": "cast",
      "what": "登場人物の設定（承認済みキャラシート）",
      "blocking": true
    },
    {
      "id": "protagonist-voice",
      "what": "主人公の承認済み音声。ナレーションも同じ声を使う",
      "blocking": true
    },
    {
      "id": "visual-profile",
      "what": "チャンネルの画風ロック",
      "blocking": true
    }
