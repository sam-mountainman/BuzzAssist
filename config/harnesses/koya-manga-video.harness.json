  "guarantees": [
    {
      "id": "character-attribute-gate",
      "what": "髪色ドリフト・微差テイク・意図外変更・装飾混入を決定論で落とす",
      "human": "目の左右のみ人手（reviewer名必須）",
      "evidenceAuditIds": [
        "independent-rendered-face",
        "editorial-quality",
        "split-page-integrity"
      ]
    },
    {
      "id": "voice-quality-gate",
      "what": "CER・UTMOS・F0分散・モーラ速度・端無音・クリッピングでテイクを選別。全滅なら停止",
      "evidenceAuditIds": [
        "stt-verification",
        "audio-onset",
        "audio-speaker-continuity",
        "audio-waveform-sync",
        "audio-click-hum-level"
      ]
    },
    {
      "id": "camera-grammar",
      "what": "方向移動／引き／方向後引きの3系統を強制し、全カット引きを防ぐ",
      "evidenceAuditIds": [
        "rendered-camera",
        "bubble-camera-sweep",
        "bubble-midpoint-frames",
        "bubble-transition-clear-frames"
      ]
    },
    {
      "id": "final-audit",
      "what": "レンダー済みMP4の実測監査。設定値ではなく出力を見る",
      "evidenceAuditIds": [
        "contract-manifest",
        "quality-harness-final",
        "bubble-typography",
        "thought-spotlight",
        "agent-contact-sheet-review",
        "full-decode"
      ]
    }
  ],
  "entrypoint": "node scripts/koya-manga-video.mjs",
  "canonicalSkills": [
    ".agents/skills/manga-video-production/SKILL.md",
    ".agents/skills/manga-page-camera/SKILL.md"
