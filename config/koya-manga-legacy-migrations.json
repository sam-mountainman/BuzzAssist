{
  "schemaVersion": 1,
  "status": "frozen-benchmark-migrations",
  "purpose": "Historical one-off migrations and evidence finalizers for manga-photo-homecoming-001. They are never production entrypoints for new episodes.",
  "officialEntrypoint": "scripts/koya-manga-video.mjs",
  "legacyEntrypoint": "scripts/build-manga-video.mjs",
  "matchedFileCount": 67,
  "rules": [
    {
      "id": "apply-version-migrations",
      "pattern": "^scripts/apply-manga-v[0-9].*\\.mjs$",
      "scope": "manga-photo-homecoming-001 historical manifest migration"
    },
    {
      "id": "finalize-version-evidence",
      "pattern": "^scripts/finalize-manga-v[0-9].*\\.mjs$",
      "scope": "manga-photo-homecoming-001 historical evidence finalization"
    },
    {
      "id": "generate-version-assets",
      "pattern": "^scripts/generate-manga-v[0-9].*\\.mjs$",
      "scope": "manga-photo-homecoming-001 historical versioned generation"
    }
  ],
  "policy": {
    "allowedForNewEpisodes": false,
    "allowedForBenchmarkRepair": true,
    "requiresExplicitEpisodeId": "manga-photo-homecoming-001",
    "newVersionedScriptsRequireInventoryUpdate": true,
    "officialModulesMayImportLegacyScripts": false
  },
  "legacyEntrypointPolicy": {
    "entrypoint": "scripts/build-manga-video.mjs",
    "productionActions": ["plan", "adopt-images", "refresh-bubbles", "speech", "render", "full"],
    "productionActionsRequire": "--benchmark-migration",
    "refusalExitCode": 2,
    "operatorEntrypoint": "node scripts/run-video-harness.mjs start --harness koya-manga-video",
    "note": "These actions write or rewrite an episode manifest, audio, or MP4 without the show rules, cast gate, external signoff, or real-MP4 audit. The CLI refuses them unless --benchmark-migration is given (the same rule as the MCP benchmarkMigration flag, lib/harnessRouting.mjs). voices, cast-voices, voice-library-audition, voice-library-approve, and status produce no episode artifact and stay open."
  }
}
