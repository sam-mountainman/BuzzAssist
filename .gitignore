tmp/
models/wd14/*.onnx
models/wd14/*.csv
.bon/

# Channel Pack — 個々のチャンネル固有のデータ。
# このリポジトリは PUBLIC なプラグイン配布リポジトリなので、
# チャンネル名・キャスト・承認記録・クライアント端末のパスを追跡しない。
# ハーネス（ジャンル共通）はここを読むが、中身は運営者ごとに置く。
channel-packs/

# 他クライアントの作業ツリー。別リポジトリなので、ここからは追跡しない。
# gitlink であっても、公開リポジトリに案件名が残る。
client-work/
config/harness-deployments.json

# One-off operator repair utilities can contain Channel Pack cast IDs and local
# workflow paths. Keep them usable on this machine without publishing them in
# the repository or npm package.
private-tools/koya/

# Channel Pack への橋渡しリンク（従来パスからの互換）。実体は channel-packs/。
config/koya-character-styling
config/koya-manga-source-face-reviews

# RunReceipt の集計置き場。記録そのものは成果物側（エピソードの監査ディレクトリ）
# に書かれる。ここは横断で見るためのローカルの集約なので追跡しない。
docs/learning/receipts/
