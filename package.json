{
  "name": "buzzassist-canvas-mcp",
  "version": "0.1.28",
  "description": "BuzzAssist project-local Excalidraw canvas plugin with MCP-backed tools for AI coding agents.",
  "homepage": "https://github.com/sam-mountainman/BuzzAssist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-mountainman/BuzzAssist.git"
  },
  "type": "module",
  "bin": {
    "buzzassist-canvas-mcp": "mcp/server.mjs",
    "buzzassist-canvas": "scripts/serve-canvas.mjs",
    "excalidraw-canvas-mcp": "mcp/server.mjs",
    "excalidraw-canvas": "scripts/serve-canvas.mjs"
  },
  "files": [
    "assets/",
    ".agents/mcp_config.json",
    ".agents/skills/",
    ".agents/plugins/marketplace.json",
    ".antigravity-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".claude/skills/",
    ".cursor/mcp.json",
    ".cursor/rules/buzzassist.mdc",
    ".mcp.json",
    "dist/",
    "dist-widget/",
    "config/harness-deployments.example.json",
    "config/harnesses/",
    "config/koya-manga-legacy-migrations.json",
    "config/koya-manga-production-contract.json",
    "config/koya-manga-production-contract.schema.json",
    "config/koya-manga-quality-incidents.json",
    "config/koya-reading-dictionary.json",
    "config/narrated-story-script-package.schema.json",
    "config/parallel-plans/",
    "config/strategy-brief.schema.json",
    "lib/*.mjs",
    "mcp/server.mjs",
    "scripts/*.mjs",
    "scripts/*.sh",
    "scripts/*.py",
    "!scripts/koya-*-2026*.mjs",
    "!scripts/koya-*-2026*.py",
    "!scripts/build-koya-setting-sheet-*.mjs",
    "!scripts/fill-koya-setting-sheet-*.mjs",
    "!scripts/tmp-*.mjs",
    "skills/",
    "hooks/",
    "./AGENTS.md",
    "./CLAUDE.md",
    "./GEMINI.md",
    "./README.md",
    "./SETUP.md",
    "package-lock.json",
    "release/package-lock.json",
    "vite.config.js",
    "docs/koya-harness-handoff-ja.md",
    "docs/koya-character-gate-runbook-ja.md",
    "docs/koya-voice-quality-runbook-ja.md",
    "docs/canvas-harness-run-ja.md",
    "docs/skill-inventory-profiles-ja.md",
    "docs/strategy-handoff-spec-ja.md",
    "docs/review/findings.jsonl",
    "docs/review/session-intake.manifest.json",
    "docs/learning/targets.json",
    "docs/learning/proposals.public.jsonl",
    "docs/measurements/parallel-limits-2026-08-28.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:widget": "node scripts/build-widget.mjs",
    "serve": "node scripts/serve-canvas.mjs",
    "setup:agents": "node scripts/setup-agents.mjs",
    "update:check": "node scripts/update-current.mjs --check-only",
    "update:now": "node scripts/update-current.mjs",
    "update:auto": "node scripts/auto-update.mjs install",
    "update:status": "node scripts/auto-update.mjs status",
    "update:disable": "node scripts/auto-update.mjs uninstall",
    "release:verify": "node scripts/verify-release-version.mjs",
    "mcp": "node mcp/server.mjs",
    "preview": "node scripts/serve-canvas.mjs",
    "speech-bubbles:render": "node scripts/render-speech-bubbles.mjs",
    "speech-bubbles:quality": "node scripts/render-speech-bubble-quality-matrix.mjs && node --test test/speechBubbleRenderer.test.mjs test/speechBubbleQualityMatrix.test.mjs",
    "manga-video": "node scripts/koya-manga-video.mjs",
    "manga-video:koya": "node scripts/koya-manga-video.mjs",
    "manga-video:koya:audit": "node scripts/koya-manga-video.mjs audit",
    "video-harness": "node scripts/run-video-harness.mjs",
    "channel-pack": "node scripts/channel-pack.mjs",
    "harness:curate": "node scripts/harness-curator.mjs",
    "harness:feedback": "node scripts/harness-feedback.mjs",
    "harness:feedback:ingest": "node scripts/harness-feedback-ingest.mjs",
    "review:intake": "node scripts/review-intake.mjs",
    "manga-video:images": "node scripts/generate-manga-script-images.mjs",
    "manga-video:audit": "node scripts/audit-manga-video.mjs",
    "manga-video:preflight": "node scripts/audit-manga-quality-harness.mjs",
    "manga-video:dag": "node scripts/execute-manga-production-dag.mjs",
    "visual-profile:quality": "node scripts/validate-channel-visual-profile.mjs",
    "security:session-logs": "node scripts/sanitize-agent-session-secrets.mjs --fail-on-findings",
    "remote:start": "node scripts/remote-canvas-relay.mjs start",
    "remote:status": "node scripts/remote-canvas-relay.mjs status",
    "remote:stop": "node scripts/remote-canvas-relay.mjs stop",
    "tunnel:start": "node scripts/canvas-tunnel.mjs start",
    "tunnel:status": "node scripts/canvas-tunnel.mjs status",
    "tunnel:stop": "node scripts/canvas-tunnel.mjs stop",
    "test": "node scripts/run-tests.mjs",
    "test:e2e:canvas": "npm run build && playwright test --config=playwright.config.mjs",
    "test:setup": "node scripts/test-setup-distribution.mjs",
    "test:project-routing": "node scripts/test-active-project-routing.mjs",
    "prepack": "npm run build && node scripts/stage-release-lock.mjs",
    "postinstall": "node scripts/patch-excalidraw.mjs",
    "public-surface": "node scripts/audit-public-surface.mjs",
    "skills:check": "node scripts/skill-inventory.mjs",
    "skills:check:release": "node scripts/skill-inventory.mjs --require-approval",
    "skills:evals": "node scripts/skill-evals.mjs",
    "instructions:generate": "node scripts/generate-host-instructions.mjs",
    "instructions:check": "node scripts/generate-host-instructions.mjs --check",
    "package:audit": "node scripts/audit-package-tarball.mjs",
    "doctor": "node scripts/harness-doctor.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "fractional-indexing": "^3.2.0",
    "kuromoji": "^0.1.2",
    "p-queue": "^9.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
